# ==============================================================================
# FICHIER D'EXEMPLE DE VARIABLES D'ENVIRONNEMENT (OPTIONNEL)
# 
# Le bot utilise principalement le fichier de configuration unifié : config.yml
# (copié depuis config.example.yml).
# 
# Les variables d'environnement listées ci-dessous permettent de surcharger 
# les réglages définis dans config.yml (idéal pour Docker, CI/CD et production).
# ==============================================================================

# Chemin optionnel vers le fichier de config YAML
# CONFIG_PATH=./config.yml

# --- Protection & Sécurité Web / API ---
# WEB_AUTH_ENABLED=false
# WEB_API_KEY=changez_cette_cle_secrete
# WEB_PROTECT_STATIC=false

# --- Planificateur de tâches (Scheduler / Cron) ---
# SCHEDULER_ENABLED=true
# SCHEDULER_TIMEZONE=Europe/Paris
# DAILY_PREVIEW_CRON="0 21 * * *"
# DAILY_PUBLISH_CRON="0 9 * * *"
# DAILY_AUTOVALIDATE_CRON="0 11 * * *"

# --- Discord & Commandes ---
# DISCORD_TOKEN=votre_discord_token_ici
# CLIENT_ID=votre_client_id_ici
# GUILD_ID=votre_guild_id_ici
# BOT_COLOR=#f2c7ce
# COMMANDS_ENABLED=true

# --- Salons Discord ---
# LOG_CHANNEL_ID=votre_salon_reserve_logs
# DAILY_MESSAGE_CHANNEL_ID=votre_salon_general_daily

# --- Base de Données & Serveur Express ---
# PORT=3000
# NODE_ENV=production
# DB_PATH=./data/bot.db

# --- OpenAI & OpenRouter ---
# OPENAI_API_KEY=votre_cle_openai_ici
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=500
# OPENAI_TEMPERATURE=0.7
# OPENROUTER_API_KEY=votre_cle_openrouter_ici
# OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- Versioning & GitHub ---
# GITHUB_REPO=sinteam-bot/chienne-bot
# GITHUB_TOKEN=
# GIT_COMMIT_SHA=
