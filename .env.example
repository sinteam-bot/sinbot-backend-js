# Database Configuration (SQLite)
DB_PATH=./data/bot.db

# Server Configuration
PORT=3000
NODE_ENV=production

# OpenAI API Configuration
OPENAI_API_KEY=votre_cle_openai_ici
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# OpenRouter API Configuration
OPENROUTER_API_KEY=votre_cle_openrouter_ici
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Discord Configuration
DISCORD_TOKEN=votre_discord_token_ici
CLIENT_ID=votre_client_id_ici
GUILD_ID=votre_guild_id_ici
BOT_COLOR=couleur_du_bot_dans_le_salon

# GitHub & Notifications de démarrage
GITHUB_REPO=sinteam-bot/chienne-bot
GITHUB_TOKEN=
NOTIFICATION_CHANNEL_ID=votre_salon_reserver
GIT_COMMIT_SHA=

# Configuration Message du jour
DAILY_MESSAGE_CHANNEL_ID=votre_salon_general
